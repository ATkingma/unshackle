<Project>
  <ItemGroup Label="Roslyn">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
  </ItemGroup>
  <ItemGroup Label="Interface">
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>
  <ItemGroup Label="DataAccess">
    <PackageVersion Include="System.IO.Abstractions" Version="22.3.0" />
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="TestableIO.System.IO.Abstractions.TestingHelpers" Version="22.3.0" />
    <PackageVersion Include="Basic.Reference.Assemblies.Net100" Version="1.8.12" />
    <!-- TAAK-325: the generic ProjectTo dispatch must translate like the closed rewrite (ToQueryString on SQLite) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Proof references: laatste vrije versies (alleen voor tests)">
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="MediatR" Version="12.5.0" />
    <PackageVersion Include="AutoMapper" Version="14.0.0" />
    <!-- Roadmap 7-9 (council round 8): last free/old versions as types for proofs, and the targets -->
    <PackageVersion Include="Moq" Version="4.18.4" />
    <PackageVersion Include="Polly" Version="7.2.4" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="EPPlus" Version="4.5.3.3" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="MassTransit" Version="8.5.12" />
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
    <!-- A package that builds on MediatR (TAAK-194): the version of the ardalis corpus case, only as types for proofs -->
    <PackageVersion Include="Ardalis.SharedKernel" Version="1.4.0" />
    <!-- MediatR registered by hand in an Autofac module (TAAK-196): the versions of the corpus case -->
    <PackageVersion Include="Autofac" Version="7.1.0" />
    <PackageVersion Include="Autofac.Extensions.DependencyInjection" Version="8.0.0" />
    <!-- TAAK-340: SpecFlow → Reqnroll (EOL fix); both BSD-3-Clause, no license or sponsor checks. Only as types for proofs -->
    <PackageVersion Include="SpecFlow" Version="3.9.74" />
    <PackageVersion Include="Reqnroll" Version="3.3.4" />
    <!-- TAAK-341: xUnit v2 as types for the xunit3 proofs' "before" (Apache-2.0); never compiled into the test project itself -->
    <PackageVersion Include="xunit.extensibility.core" Version="2.9.3" />
    <PackageVersion Include="xunit.extensibility.execution" Version="2.9.3" />
    <PackageVersion Include="xunit.assert" Version="2.9.3" />
    <PackageVersion Include="xunit.abstractions" Version="2.0.3" />
  </ItemGroup>
</Project>
