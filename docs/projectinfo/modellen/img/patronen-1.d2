title: "[Overzicht] Waarden, booleans, null, leeg, tellen, vergelijken" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: right
vars: {
  d2-legend: {
    f: FluentAssertions {style.fill: "#bbdefb"}
    s: Shouldly {style.fill: "#c8e6c9"}
    m: Manual {style.fill: "#ffe0b2"}
    a: "" {style.opacity: 0}
    b: "" {style.opacity: 0}
    a -> b: Wordt
  }
}
be: "x.Should().Be(y)" {style.fill: "#bbdefb"}
bes: "x.ShouldBe(y)\n(cast bij numeriek type)" {style.fill: "#c8e6c9"}
bem: "Manual: XML/Types, comparer,\nonverenigbaar type" {style.fill: "#ffe0b2"}
cnt: "x.Should().HaveCount(n)" {style.fill: "#bbdefb"}
cnts: "x.Length / x.Count / x.Count().ShouldBe(n)\n(+ using System.Linq)" {style.fill: "#c8e6c9"}
cntm: "Manual: predicate, dictionary,\n?., niet-generiek IEnumerable" {style.fill: "#ffe0b2"}
tf: "x.Should().BeTrue() / BeFalse()" {style.fill: "#bbdefb"}
tfs: "x.ShouldBeTrue() / ShouldBeFalse()\nbool?: x.ShouldBe(true)" {style.fill: "#c8e6c9"}
tfm: "Manual: type niet bool/bool?" {style.fill: "#ffe0b2"}
nul: "x.Should().BeNull() / NotBeNull()" {style.fill: "#bbdefb"}
nuls: "x.ShouldBeNull() / ShouldNotBeNull()" {style.fill: "#c8e6c9"}
nulm: "Manual: alleen gedeelde gevallen" {style.fill: "#ffe0b2"}
emp: "x.Should().BeEmpty() / NotBeEmpty()" {style.fill: "#bbdefb"}
emps: "x.ShouldBeEmpty() / ShouldNotBeEmpty()" {style.fill: "#c8e6c9"}
empm: "Manual: alleen gedeelde gevallen" {style.fill: "#ffe0b2"}
gl: "x.Should().BeGreaterThan(y) / BeLessThan / ...OrEqualTo,\nBeInRange, BePositive, BeNegative" {style.fill: "#bbdefb"}
gls: "x.ShouldBeGreaterThan(y) / ShouldBeLessThan / ...,\nShouldBeInRange, ShouldBePositive, ShouldBeNegative" {style.fill: "#c8e6c9"}
glm: "Manual: nullable subject, niet IComparable<T>,\nsubject twee keer geevalueerd,\nBePositive op ander type dan int/long/short/\ndecimal/double/float" {style.fill: "#ffe0b2"}
be -> bes
be -> bem
cnt -> cnts
cnt -> cntm
tf -> tfs
tf -> tfm
nul -> nuls
nul -> nulm
emp -> emps
emp -> empm
gl -> gls
gl -> glm
