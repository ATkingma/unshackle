title: "[Overzicht] Getallen, datums, tellen, strings" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: right
vars: {
  d2-legend: {
    f: FluentAssertions {style.fill: "#bbdefb"}
    s: Shouldly {style.fill: "#c8e6c9"}
    a: "" {style.opacity: 0}
    b: "" {style.opacity: 0}
    a -> b: Wordt
  }
}
f0: "fa.be-greater-less\nBeGreaterThan, BeLessThan, BeInRange, BePositive, BeAfter, ..." {style.fill: "#bbdefb"}
s0: "ShouldBeGreaterThan, ShouldBeInRange, ShouldBePositive, ..." {style.fill: "#c8e6c9"}
f0 -> s0
f1: "fa.be-approximately\nBeApproximately(y, tol), BeCloseTo(t, span), Not..." {style.fill: "#bbdefb"}
s1: "ShouldBe(y, tol); Not: ShouldNotBe of Math.Abs(x - y).ShouldBeGreaterThan(tol)" {style.fill: "#c8e6c9"}
f1 -> s1
f2: "fa.have-count\nHaveCount(n), HaveCountGreaterThan(n), ..." {style.fill: "#bbdefb"}
s2: ".Length/.Count/.Count() plus ShouldBe(n) / ShouldBeGreaterThan(n)" {style.fill: "#c8e6c9"}
f2 -> s2
f3: "fa.have-length\nHaveLength(n)" {style.fill: "#bbdefb"}
s3: "s.Length.ShouldBe(n)" {style.fill: "#c8e6c9"}
f3 -> s3
f4: "fa.string-start-end\nStartWith, EndWith, NotBeNullOrEmpty, ..." {style.fill: "#bbdefb"}
s4: "ShouldStartWith(x, Case.Sensitive), ShouldNotBeNullOrEmpty(), ..." {style.fill: "#c8e6c9"}
f4 -> s4
f5: "fa.match\nMatchRegex(r), Match(\"SO-*\"), Not..." {style.fill: "#bbdefb"}
s5: "ShouldMatch(r), ShouldMatch(@\"(?s)\\ASO-.*\$\")" {style.fill: "#c8e6c9"}
f5 -> s5
