title: "[Overzicht] Collecties en dictionaries" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: right
vars: {
  d2-legend: {
    f: FluentAssertions {style.fill: "#bbdefb"}
    s: Shouldly {style.fill: "#c8e6c9"}
    a: "" {style.opacity: 0}
    b: "" {style.opacity: 0}
    a -> b: Wordt
  }
}
f0: "fa.contain\nContain(item of predicate), NotContain" {style.fill: "#bbdefb"}
s0: "ShouldContain, ShouldNotContain (string: Case.Sensitive)" {style.fill: "#c8e6c9"}
f0 -> s0
f1: "fa.contain-key\nContainKey(k), NotContainKey(k)" {style.fill: "#bbdefb"}
s1: "ShouldContainKey(k), ShouldNotContainKey(k)" {style.fill: "#c8e6c9"}
f1 -> s1
f2: "fa.contain-single-which\nContainSingle(), ContainSingle(p)[.Which]" {style.fill: "#bbdefb"}
s2: "ShouldHaveSingleItem(), ShouldContain(p, 1), x.Where(p).ShouldHaveSingleItem()" {style.fill: "#c8e6c9"}
f2 -> s2
f3: "fa.only-contain\nOnlyContain(pred)" {style.fill: "#bbdefb"}
s3: "ShouldNotBeEmpty(); ShouldAllBe(pred)" {style.fill: "#c8e6c9"}
f3 -> s3
f4: "fa.all-satisfy\nAllSatisfy(a => { ... })" {style.fill: "#bbdefb"}
s4: "ShouldNotBeEmpty(); foreach (var a in x) { ... }" {style.fill: "#c8e6c9"}
f4 -> s4
f5: "fa.equal-sequence\nEqual(seq), Equal(1, 2), NotEqual" {style.fill: "#bbdefb"}
s5: "ShouldBe(seq), ShouldBe(new[] { 1, 2 }) (volgorde telt)" {style.fill: "#c8e6c9"}
f5 -> s5
f6: "fa.direct-mapping\nBeOneOf, BeSubsetOf, OnlyHaveUniqueItems, HaveValue" {style.fill: "#bbdefb"}
s6: "ShouldBeOneOf, ShouldBeSubsetOf, ShouldBeUnique, ShouldNotBeNull" {style.fill: "#c8e6c9"}
f6 -> s6
