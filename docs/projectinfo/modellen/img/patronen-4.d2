title: "[Overzicht] Equivalentie" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: right
vars: {
  d2-legend: {
    f: FluentAssertions {style.fill: "#bbdefb"}
    s: Shouldly {style.fill: "#c8e6c9"}
    m: Manual {style.fill: "#ffe0b2"}
    a: "" {style.opacity: 0}
    b: "" {style.opacity: 0}
    a -> b: Wordt
  }
}
bes: "s.Should().BeEquivalentTo(y)\n(string)" {style.fill: "#bbdefb"}
bess: "s.ShouldBe(y, StringCompareShould.IgnoreCase)" {style.fill: "#c8e6c9"}
besm: "Manual: NotBeEquivalentTo, resultaat gebruikt,\nbecauseArgs" {style.fill: "#ffe0b2"}
beo: "a.Should().BeEquivalentTo(b)\n(object)" {style.fill: "#bbdefb"}
beos: "a.ShouldBeEquivalentTo(b)\n(alleen gelijk type en eenvoudige leden)" {style.fill: "#c8e6c9"}
beom: "Manual: verschillend type, collectie,\nEquals-override, cyclus, options =>" {style.fill: "#ffe0b2"}
bes -> bess
bes -> besm
beo -> beos
beo -> beom
