title: "[Sequence] AllSatisfyPattern" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
shape: sequence_diagram
fixer: Fixer
base: FluentAssertionPattern
pattern: AllSatisfyPattern
syntax: FluentAssertionsSyntax
fixer -> pattern: "Find(root, model)"
pattern -> syntax: "FindInvocations(root, model, \"AllSatisfy\")"
syntax -> pattern: "aanroepen" {style.stroke-dash: 3}
pattern -> fixer: "statements (of aanroep)" {style.stroke-dash: 3}
loop: "loop [elke node]" {
  fixer -> base: "Rewrite(node, model)"
  base -> syntax: "IsInsideAssertionScope, GetSubject, IsResultDiscarded, TryGetArguments"
  syntax -> base: "lambda + because" {style.stroke-dash: 3}
  base -> pattern: "RewriteAssertion(context)"
  pattern -> syntax: "TryGetSplittableStatement, IsSafeToEvaluateTwice / Hoist"
  pattern -> pattern: "Reindent(...)"
  alt: "alt" {
    pattern -> fixer: "Fixed([var subject = x;]? ShouldNotBeEmpty, foreach)" {style.stroke-dash: 3}
  }
  alt2: "else" {
    pattern -> fixer: "Manual(reden)" {style.stroke-dash: 3}
  }
}
