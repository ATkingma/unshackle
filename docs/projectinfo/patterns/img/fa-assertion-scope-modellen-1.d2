title: "[Klassen] AssertionScopePattern" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
IPattern: {shape: class; "+Id: string"; "+Find(root, model)"; "+Rewrite(node, model): PatternResult"}
AssertionScopePattern: {shape: class; "+Id = fa.assertion-scope"; "+Find(root, model)"; "+Rewrite(node, model)"}
FluentAssertionsSyntax: {shape: class; "+InsideAssertionScopeReason"; "+IsAssertionScope(type): bool"; "+IsInsideAssertionScope(node, model): bool"}
