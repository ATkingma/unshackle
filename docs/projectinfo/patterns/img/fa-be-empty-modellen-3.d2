title: "[Activity] FluentAssertionPattern.Rewrite → BeEmptyPattern.RewriteAssertion - Fixed of Manual" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: down
vars: {
  d2-legend: {
    f: Fixed {style.fill: "#c8e6c9"; style.font-color: "#000000"}
    m: Manual {style.fill: "#ffe0b2"; style.font-color: "#000000"}
  }
}
start: "" {shape: circle; width: 20; style: {fill: black; stroke: "#9ca3af"}}
q1: "Vorm x.Should().BeEmpty()?" {shape: diamond}
m1: "Manual: BeEmpty()/NotBeEmpty() is not in the form x.Should()...\n(proof: and-chain)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q2: "Resultaat weggegooid?" {shape: diamond}
m2: "Manual: The result of BeEmpty()/NotBeEmpty() is used\n(proof: chain, value-used)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q3: "Geen benoemde argumenten; becauseArgs alleen met constante because?" {shape: diamond}
m3: "Manual: named arguments, or becauseArgs whose because is no constant format string\n(geen proof)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
s: "Welke methode?" {shape: diamond}
f1: "Fixed: x.ShouldBeEmpty([because]) (string, lijst, enumerable, dictionary)\n(proof: be-empty-list, string, enumerable, dictionary, because, because-args,\nlambda, nullable, edge-linq-subject, edge-await-subject)" {style.fill: "#c8e6c9"; style.font-color: "#000000"; style.border-radius: 12}
f2: "Fixed: x.ShouldNotBeEmpty([because])\n(proof: not-be-empty-list)" {style.fill: "#c8e6c9"; style.font-color: "#000000"; style.border-radius: 12}
start -> q1
q1 -> m1: nee
q1 -> q2: ja
q2 -> m2: nee
q2 -> q3: ja
q3 -> m3: nee
q3 -> s: ja
s -> f1: "BeEmpty"
s -> f2: "NotBeEmpty"
