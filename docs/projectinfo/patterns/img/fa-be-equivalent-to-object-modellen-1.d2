ipattern: "«interface» IPattern" {
  shape: class
  "+Id": string
  "+Description": string
  "+Find(root, model)": "IEnumerable<SyntaxNode>"
  "+Rewrite(node, model)": PatternResult
}
base: "«abstract» FluentAssertionPattern" {
  shape: class
  "+Rewrite(node, model)": PatternResult
  "#RewriteAssertion(context)": PatternResult
}
BeEquivalentToObjectPattern: BeEquivalentToObjectPattern {
  shape: class
  "+Id": "fa.be-equivalent-to-object"
  "+Find(root, model)": "IEnumerable<SyntaxNode>"
  "#RewriteAssertion(context)": PatternResult
  "-Unsupported(type, requireMembers, path)": "string?"
  "-IsLeaf(type)": bool
  "-HasEqualsOverride(type)": bool
}
syntax: FluentAssertionsSyntax {
  shape: class
  "+FindInvocations(root, model, names)": "IEnumerable<InvocationExpressionSyntax>"
  "+GetSubject(assertion)": "ExpressionSyntax?"
  "+IsResultDiscarded(assertion, model)": bool
  "+TryGetArguments(assertion, model, values, because)": bool
}
result: "PatternResult (abstract)" {
  shape: class
  "+Fixed(newNode, namespaces)": PatternResult
  "+Manual(reason)": PatternResult
}
fixed: FixedResult {
  shape: class
  "+NewNodes": "IReadOnlyList<SyntaxNode>"
}
manual: ManualResult {
  shape: class
  "+Reason": string
}
fa: "«FluentAssertions» herkend" {
  shape: class
  "ObjectAssertions.BeEquivalentTo(expected[, because])": ""
  "BeEquivalentTo(expected, options => ...)": ""
  "NotBeEquivalentTo(...)": ""
}
sh: "«Shouldly» aangemaakt" {
