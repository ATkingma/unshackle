title: "[Sequence] BeEquivalentToObjectPattern - Find en Rewrite" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
shape: sequence_diagram
fixer: Fixer
pattern: BeEquivalentToObjectPattern
syntax: FluentAssertionsSyntax
model: SemanticModel
result: PatternResult
fixer -> pattern: "Find(root, model)"
pattern -> syntax: "FindInvocations(root, model, \"BeEquivalentTo\", \"NotBeEquivalentTo\")"
syntax -> model: "GetSymbolInfo(invocation): IsFluentAssertions"
pattern -> model: "GetSymbolInfo(i): ContainingType niet StringAssertions"
pattern -> fixer: "nodes" {style.stroke-dash: 3}
each: "loop [elke node]" {
  fixer -> pattern: "Rewrite(node, model)"
  checks: "opt [controles]" {
    pattern -> syntax: "GetSubject(assertion)"
    pattern -> syntax: "IsResultDiscarded(assertion, model)"
    pattern -> syntax: "TryGetArguments(assertion, model)"
    pattern -> model: "GetTypeInfo(subject), GetTypeInfo(expected)"
    pattern -> pattern: "Unsupported(type): leden, Equals, cyclus"
  }
  manual: "alt [een controle faalt]" {
    pattern -> result: "Manual(reden)"
    pattern -> fixer: "ManualResult" {style.stroke-dash: 3}
  }
  fixed: "alt [alle controles slagen]" {
    pattern -> result: "Fixed(nieuwe node)"
    pattern -> fixer: "FixedResult" {style.stroke-dash: 3}
  }
}
