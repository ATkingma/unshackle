title: "[Activity] BeEquivalentToObjectPattern.Rewrite - Fixed of Manual" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: down
vars: {
  d2-legend: {
    f: Fixed {style.fill: "#c8e6c9"; style.font-color: "#000000"}
    m: Manual {style.fill: "#ffe0b2"; style.font-color: "#000000"}
  }
}
start: "" {shape: circle; width: 20; style: {fill: black; stroke: "#9ca3af"}}
q1: "Vorm x.Should().BeEquivalentTo(...)?" {shape: diamond}
m1: "Manual: is not in the form\n(proof: and-chain)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q2: "BeEquivalentTo, niet NotBeEquivalentTo?" {shape: diamond}
m2: "Manual: NotBeEquivalentTo has no Shouldly equivalent\n(proof: not-equivalent)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q3: "Resultaat weggegooid?" {shape: diamond}
m3: "Manual: The result of ... is used\n(proof: value-used)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q4: "Geen becauseArgs?" {shape: diamond}
m4: "Manual: becauseArgs\n(proof: because-args)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q5: "Precies één waarde (geen options)?" {shape: diamond}
m5: "Manual: options => ... configuration\n(proof: options)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q6: "Zelfde compile-time type, niet anoniem?" {shape: diamond}
m6: "Manual: Different compile-time types\n(proof: anonymous, different-types, base-vs-derived)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q7: "Gewoon type zonder collectie, object, Equals-override, cyclus; met publieke leden?" {shape: diamond}
m7: "Manual: collection / not a plain class / overrides Equals / cyclic / no public members\n(proof: collection, collection-member, object-subject, object-member, equals-override, equals-member, cyclic, no-members)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
s: "Is er een because?" {shape: diamond}
f1: "Fixed: a.ShouldBeEquivalentTo(b)\n(proof: simple, new-expectation, record, nested, lambda)" {style.fill: "#c8e6c9"; style.font-color: "#000000"; style.border-radius: 12}
f2: "Fixed: a.ShouldBeEquivalentTo(b, because)\n(proof: because)" {style.fill: "#c8e6c9"; style.font-color: "#000000"; style.border-radius: 12}
start -> q1
q1 -> m1: nee
q1 -> q2: ja
q2 -> m2: nee
q2 -> q3: ja
q3 -> m3: nee
q3 -> q4: ja
q4 -> m4: nee
q4 -> q5: ja
q5 -> m5: nee
q5 -> q6: ja
q6 -> m6: nee
q6 -> q7: ja
q7 -> m7: nee
q7 -> s: ja
s -> f1: nee
s -> f2: ja
