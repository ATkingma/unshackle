title: "[Class] BeGreaterLessPattern" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: right
ipattern: "«interface» IPattern" {
  shape: class
  "+Id": string
  "+Find(root, model)": "IEnumerable<SyntaxNode>"
  "+Rewrite(node, model)": PatternResult
}
base: "«abstract» FluentAssertionPattern" {
  shape: class
  "+Rewrite(node, model)": PatternResult
  "#RewriteAssertion(context)": PatternResult
}
pattern: BeGreaterLessPattern {
  shape: class
  "-s_methods": "Dictionary<string, (Should, Values)>"
  "-s_signTypes": "SpecialType[]"
  "+Find(root, model)": "IEnumerable<SyntaxNode>"
  "#RewriteAssertion(context)": PatternResult
}
syntax: FluentAssertionsSyntax {
  shape: class
  "+FindInvocations(root, model, names)": ""
  "+GetSubject(assertion)": ExpressionSyntax
  "+IsResultDiscarded(assertion, model)": bool
  "+TryGetArguments(...)": bool
  "+ConvertExpected(expected, subjectType, model, position)": "ExpressionSyntax?"
}
result: PatternResult {
  shape: class
  "+Fixed(node, namespaces)": ""
  "+Manual(reason)": ""
}
fixed: FixedResult {shape: class; "+NewNodes": ""}
manual: ManualResult {shape: class; "+Reason": string}
fa: "FluentAssertions\nBeGreaterThan, BeGreaterThanOrEqualTo, BeGreaterOrEqualTo,\nBeLessThan, BeLessThanOrEqualTo, BeLessOrEqualTo,\nBeInRange, NotBeInRange, BePositive, BeNegative,\nBeAfter, BeOnOrAfter, BeBefore, BeOnOrBefore"
sh: "Shouldly\nShouldBeGreaterThan, ShouldBeGreaterThanOrEqualTo, ShouldBeLessThan,\nShouldBeLessThanOrEqualTo, ShouldBeInRange, ShouldNotBeInRange,\nShouldBePositive, ShouldBeNegative"
pattern -> base: {style.stroke-dash: 0; target-arrowhead.shape: triangle}
base -> ipattern: {style.stroke-dash: 0; target-arrowhead.shape: triangle}
pattern -> syntax: gebruikt {style.stroke-dash: 3}
pattern -> result: maakt {style.stroke-dash: 3}
fixed -> result: {target-arrowhead.shape: triangle}
manual -> result: {target-arrowhead.shape: triangle}
fa -> pattern: herkend door Find {style.stroke-dash: 3}
pattern -> sh: bouwt {style.stroke-dash: 3}
