title: "[Sequence] BeGreaterLessPattern" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
shape: sequence_diagram
fixer: Fixer
pattern: BeGreaterLessPattern
syntax: FluentAssertionsSyntax
model: SemanticModel
fixer -> pattern: "Find(root, model)"
pattern -> syntax: "FindInvocations(root, model, namen)"
syntax -> pattern: "comparison-aanroepen" {style.stroke-dash: 3}
pattern -> fixer: "bovenste aanroep of ExpressionStatement per keten" {style.stroke-dash: 3}
loop: "loop [elke node]" {
  fixer -> pattern: "Rewrite(node, model)"
  pattern -> syntax: "GetSubject(link) per schakel"
  pattern -> syntax: "IsResultDiscarded(top, model)"
  pattern -> model: "GetTypeInfo(subject)"
  pattern -> syntax: "TryGetArguments(link, model)"
  syntax -> pattern: "waarden + because" {style.stroke-dash: 3}
  alt: "alt" {
    pattern -> fixer: "Fixed(invocation | statements)" {style.stroke-dash: 3}
  }
  alt2: "else" {
    pattern -> fixer: "Manual(reden)" {style.stroke-dash: 3}
  }
}
