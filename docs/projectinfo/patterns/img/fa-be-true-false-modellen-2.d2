title: "[Sequence] BeTrueFalsePattern - Find en Rewrite" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
shape: sequence_diagram
fixer: Fixer
base: FluentAssertionPattern
pattern: BeTrueFalsePattern
syntax: FluentAssertionsSyntax
model: SemanticModel
result: PatternResult
fixer -> pattern: "Find(root, model)"
pattern -> syntax: "FindInvocations(root, model, \"BeTrue\", \"BeFalse\")"
syntax -> model: "GetSymbolInfo(invocation): IsFluentAssertions"
syntax -> pattern: "InvocationExpressionSyntax-nodes" {style.stroke-dash: 3}
pattern -> fixer: "nodes" {style.stroke-dash: 3}
each: "loop [elke node]" {
  fixer -> base: "Rewrite(node, model)"
  checks: "opt [controles]" {
    base -> syntax: "IsInsideAssertionScope(node, model)"
    base -> syntax: "GetSubject(assertion)"
    base -> syntax: "IsResultDiscarded(assertion, model)"
    base -> syntax: "TryGetArguments(assertion, model)"
    base -> pattern: "RewriteAssertion(context)"
    pattern -> model: "GetTypeInfo(subject): bool of bool??"
  }
  manual: "alt [een controle faalt]" {
    base -> result: "Manual(reden)"
    base -> fixer: "ManualResult" {style.stroke-dash: 3}
  }
  fixed: "alt [alle controles slagen]" {
    pattern -> result: "Fixed(nieuwe node)"
    pattern -> base: "FixedResult" {style.stroke-dash: 3}
    base -> fixer: "FixedResult" {style.stroke-dash: 3}
  }
}
