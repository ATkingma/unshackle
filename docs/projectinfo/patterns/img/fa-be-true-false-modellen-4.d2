s: "Welk type heeft het subject?" {shape: diamond}
f1: "Fixed: x.ShouldBeTrue([because]) / x.ShouldBeFalse([because])\n(proof: be-true, be-false, because, because-args, edge-has-value, edge-interpolated-because, edge-linq-subject, edge-pattern-subject)" {style.fill: "#c8e6c9"; style.font-color: "#000000"; style.border-radius: 12}
f2: "Fixed: x.ShouldBe(true|false[, because])\n(proof: nullable)" {style.fill: "#c8e6c9"; style.font-color: "#000000"; style.border-radius: 12}
