title: "[Class] ContainKeyPattern" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: right
ipattern: "«interface» IPattern" {
  shape: class
  "+Id": string
  "+Find(root, model)": "IEnumerable<SyntaxNode>"
  "+Rewrite(node, model)": PatternResult
}
pattern: ContainKeyPattern {
  shape: class
  "+Find(root, model)": "IEnumerable<SyntaxNode>"
  "+Rewrite(node, model)": PatternResult
}
syntax: FluentAssertionsSyntax {
  shape: class
  "+FindInvocations(root, model, names)": ""
  "+GetSubject(assertion)": ExpressionSyntax
  "+IsResultDiscarded(assertion, model)": bool
  "+TryGetArguments(...)": bool
}
result: PatternResult {
  shape: class
  "+Fixed(node, namespaces)": ""
  "+Manual(reason)": ""
}
fixed: FixedResult {shape: class; "+NewNodes": ""}
manual: ManualResult {shape: class; "+Reason": string}
fa: "FluentAssertions\nContainKey, NotContainKey (Fixed)\nContainKeys, NotContainKeys,\nContainValue(s), NotContainValue(s) (Manual)"
sh: "Shouldly\nShouldContainKey, ShouldNotContainKey"
pattern -> ipattern: {style.stroke-dash: 0; target-arrowhead.shape: triangle}
