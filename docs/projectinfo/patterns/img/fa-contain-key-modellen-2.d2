title: "[Sequence] ContainKeyPattern" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
shape: sequence_diagram
fixer: Fixer
base: FluentAssertionPattern
pattern: ContainKeyPattern
syntax: FluentAssertionsSyntax
fixer -> pattern: "Find(root, model)"
pattern -> syntax: "FindInvocations(root, model, namen)"
syntax -> pattern: "aanroepen" {style.stroke-dash: 3}
pattern -> fixer: "nodes" {style.stroke-dash: 3}
loop: "loop [elke node]" {
  fixer -> base: "Rewrite(node, model)"
  base -> syntax: "IsInsideAssertionScope(node, model)"
  base -> syntax: "GetSubject(assertion)"
  base -> syntax: "IsResultDiscarded(assertion, model)"
  base -> pattern: "RewriteBeforeArguments(context): …Keys / …Value(s)?"
  base -> syntax: "TryGetArguments(assertion, model)"
  syntax -> base: "waarden + because" {style.stroke-dash: 3}
  base -> pattern: "RewriteAssertion(context)"
  pattern -> syntax: "NotNull(subject, model)"
  alt: "alt" {
    pattern -> base: "Fixed(ShouldContainKey(...))" {style.stroke-dash: 3}
  }
  alt2: "else" {
    pattern -> base: "Manual(reden)" {style.stroke-dash: 3}
  }
  base -> fixer: "PatternResult" {style.stroke-dash: 3}
}
