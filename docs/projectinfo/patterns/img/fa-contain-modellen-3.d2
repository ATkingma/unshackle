title: "[Activity] FluentAssertionPattern.Rewrite + ContainPattern.RewriteAssertion - Fixed of Manual (1/2)" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: down
vars: {
  d2-legend: {
    f: Fixed {style.fill: "#c8e6c9"; style.font-color: "#000000"}
    m: Manual {style.fill: "#ffe0b2"; style.font-color: "#000000"}
  }
}
start: "" {shape: circle; width: 20; style: {fill: black; stroke: "#9ca3af"}}
q0: "Buiten een AssertionScope?" {shape: diamond}
m0: "Manual: Inside an AssertionScope\n(geen eigen proof; zie AssertionScope)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q1: "Vorm x.Should().Contain(...)?" {shape: diamond}
m1: "Manual: Contain(...) is not in the form x.Should()...\n(proof: and-chain)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q2: "Resultaat weggegooid?" {shape: diamond}
m2: "Manual: The result of Contain(...) is used\n(proof: chain, value-used)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q3: "Subject is geen dictionary?" {shape: diamond}
m3: "Manual: Dictionary: takes key/value pairs; use ShouldContainKey/ShouldContainKeyAndValue\n(proof: dictionary)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q4: "Geen benoemde argumenten; becauseArgs alleen met constante because?" {shape: diamond}
m4: "Manual: named arguments, or becauseArgs whose because is no constant format string\n(geen proof)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
to_next_q5: "Continued in Figure 3b" {shape: page; style: {fill: "#e5e7eb"; font-color: "#000000"}}
start -> q0
q0 -> m0: nee
q0 -> q1: ja
q1 -> m1: nee
q1 -> q2: ja
q2 -> m2: nee
q2 -> q3: ja
q3 -> m3: nee
q3 -> q4: ja
q4 -> m4: nee
q4 -> to_next_q5: ja
