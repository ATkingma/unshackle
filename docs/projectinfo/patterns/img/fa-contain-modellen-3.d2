title: "[Activity] ContainPattern.Rewrite - Fixed of Manual" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: down
vars: {
  d2-legend: {
    f: Fixed {style.fill: "#c8e6c9"; style.font-color: "#000000"}
    m: Manual {style.fill: "#ffe0b2"; style.font-color: "#000000"}
  }
}
start: "" {shape: circle; width: 20; style: {fill: black; stroke: "#9ca3af"}}
q1: "Vorm x.Should().Contain(...)?" {shape: diamond}
m1: "Manual: Contain(...) is not in the form x.Should()...\n(proof: and-chain)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q2: "Resultaat weggegooid?" {shape: diamond}
m2: "Manual: The result of Contain(...) is used\n(proof: chain, value-used)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q3: "Subject is geen dictionary?" {shape: diamond}
m3: "Manual: Dictionary: use ShouldContainKey by hand\n(proof: dictionary)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q4: "Geen becauseArgs of benoemde argumenten?" {shape: diamond}
m4: "Manual: becauseArgs of benoemde argumenten\n(proof: because-args)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q5: "Eén waarde-argument (geen occurrence-constraint)?" {shape: diamond}
m5: "Manual: an occurrence constraint: no Shouldly equivalent\n(proof: occurrence)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q6: "Parameter is item of predicaat (niet meerdere items)?" {shape: diamond}
m6: "Manual: checks several items at once\n(proof: items)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q7: "Subject is string of IEnumerable<T>?" {shape: diamond}
m7: "Manual: The subject is not a string or a generic IEnumerable<T>\n(geen proof)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
s: "Welk subject en welke overload?" {shape: diamond}
f1: "Fixed: x.ShouldContain(v, Shouldly.Case.Sensitive[, because])\n(proof: string)" {style.fill: "#c8e6c9"; style.font-color: "#000000"; style.border-radius: 12}
f2: "Fixed: x.ShouldContain(item[, because])\n(proof: list, enumerable, lambda, because)" {style.fill: "#c8e6c9"; style.font-color: "#000000"; style.border-radius: 12}
f3: "Fixed: x.ShouldContain(predicate)\n(proof: predicate)" {style.fill: "#c8e6c9"; style.font-color: "#000000"; style.border-radius: 12}
f4: "Fixed: x.ShouldNotContain(...)\n(proof: not-contain)" {style.fill: "#c8e6c9"; style.font-color: "#000000"; style.border-radius: 12}
start -> q1
q1 -> m1: nee
q1 -> q2: ja
q2 -> m2: nee
q2 -> q3: ja
q3 -> m3: nee
q3 -> q4: ja
q4 -> m4: nee
q4 -> q5: ja
q5 -> m5: nee
q5 -> q6: ja
q6 -> m6: nee
q6 -> q7: ja
q7 -> m7: nee
q7 -> s: ja
s -> f1: "string"
s -> f2: "IEnumerable<T>, item"
s -> f3: "IEnumerable<T>, predicaat"
s -> f4: "NotContain"
