title: "[Activity] FluentAssertionPattern.Rewrite + EqualSequencePattern - Fixed of Manual" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: down
vars: {
  d2-legend: {
    f: Fixed {style.fill: "#c8e6c9"; style.font-color: "#000000"}
    m: Manual {style.fill: "#ffe0b2"; style.font-color: "#000000"}
  }
}
start: "" {shape: circle; width: 20; style: {fill: black; stroke: "#9ca3af"}}
q0: "Buiten een AssertionScope?" {shape: diamond}
m0: "Manual: Inside an AssertionScope\n(proof: assertion-scope)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
start -> q0
q0 -> m0: nee
q1: "Vorm x.Should().Equal(..)?" {shape: diamond}
m1: "Manual: is not in the form x.Should()\n(geen proof; .And via fa.and-chain)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q0 -> q1: ja
q1 -> m1: nee
q2: "Resultaat weggegooid?" {shape: diamond}
m2: "Manual: is used\n(proof: and)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q1 -> q2: ja
q2 -> m2: nee
q3: "RewriteBeforeArguments: op Generic/StringCollectionAssertions?" {shape: diamond}
m3: "Manual: dictionary compares without order\n(proof: dictionary)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q2 -> q3: ja
q3 -> m3: nee
q4: "Equal (niet NotEqual)?" {shape: diamond}
m4: "Manual: Shouldly has no ShouldNotBe for sequences\n(proof: not-equal)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q3 -> q4: ja
q4 -> m4: nee
q5: "Geen predicate?" {shape: diamond}
m5: "Manual: with a predicate\n(proof: predicate)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q4 -> pa: ja
pa: "Losse params-elementen (geen array)?" {shape: diamond}
fp: "Fixed: x.ShouldBe(new T[] { a, b }) (becauseArgs-controle overgeslagen)\n(params)" {style.fill: "#c8e6c9"; style.font-color: "#000000"; style.border-radius: 12}
pa -> fp: ja
pa -> q5: nee
q5 -> m5: nee
q6: "Geen benoemde argumenten; because constant formatteerbaar?" {shape: diamond}
m6: "Manual: named arguments, or becauseArgs whose because is no constant format string\n(geen proof)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q5 -> q6: ja
q6 -> m6: nee
f0: "Fixed: x.ShouldBe(y[, ignoreOrder: false, because])\n(simple, params-array, because, because-args, nullable)" {style.fill: "#c8e6c9"; style.font-color: "#000000"; style.border-radius: 12}
q6 -> f0: ja
