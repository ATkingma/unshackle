title: "[Activity] FluentAssertionPattern.Rewrite + HaveCountPattern.RewriteAssertion - Fixed of Manual (1/2)" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: down
vars: {
  d2-legend: {
    f: Fixed {style.fill: "#c8e6c9"; style.font-color: "#000000"}
    m: Manual {style.fill: "#ffe0b2"; style.font-color: "#000000"}
  }
}
start: "" {shape: circle; width: 20; style: {fill: black; stroke: "#9ca3af"}}
q1: "Buiten een AssertionScope?" {shape: diamond}
m1: "Manual: Inside an AssertionScope\n(geen proof)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q2: "Vorm x.Should().HaveCount(n)?" {shape: diamond}
m2: "Manual: HaveCount(...) is not in the form x.Should().HaveCount(...)\n(geen proof)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q3: "Resultaat weggegooid?" {shape: diamond}
m3: "Manual: The result of HaveCount(...) is used\n(proof: chain)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q4: "Geen benoemde argumenten; because constant formatteerbaar?" {shape: diamond}
m4: "Manual: named arguments, or becauseArgs whose because is no constant format string\n(geen proof)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q5: "Subject zonder ?. (conditional access)?" {shape: diamond}
m5: "Manual: The subject uses ?.\n(geen proof)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
to_next_q6: "Continued in Figure 3b" {shape: page; style: {fill: "#e5e7eb"; font-color: "#000000"}}
start -> q1
q1 -> m1: nee
q1 -> q2: ja
q2 -> m2: nee
q2 -> q3: ja
q3 -> m3: nee
q3 -> q4: ja
q4 -> m4: nee
q4 -> q5: ja
