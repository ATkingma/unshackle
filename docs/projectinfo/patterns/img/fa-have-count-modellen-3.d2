title: "[Activity] HaveCountPattern.Rewrite - Fixed of Manual" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: down
vars: {
  d2-legend: {
    f: Fixed {style.fill: "#c8e6c9"; style.font-color: "#000000"}
    m: Manual {style.fill: "#ffe0b2"; style.font-color: "#000000"}
  }
}
start: "" {shape: circle; width: 20; style: {fill: black; stroke: "#9ca3af"}}
q1: "Vorm x.Should().HaveCount(n)?" {shape: diamond}
m1: "Manual: HaveCount(...) is not in the form x.Should().HaveCount(n)\n(geen proof)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q2: "Resultaat weggegooid?" {shape: diamond}
m2: "Manual: The result of HaveCount(...) is used\n(proof: chain)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q3: "Subject zonder ?. (conditional access)?" {shape: diamond}
m3: "Manual: The subject uses ?.\n(geen proof)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q4: "Eerste parameter is int (geen predicate)?" {shape: diamond}
m4: "Manual: Predicate: rewrite by hand\n(proof: predicate)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q5: "Geen becauseArgs of benoemde argumenten?" {shape: diamond}
m5: "Manual: becauseArgs of benoemde argumenten\n(proof: because-args)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q6: "Type van het subject bekend?" {shape: diamond}
m6: "Manual: The type of the subject is unknown\n(geen proof)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q7: "Geen IDictionary / IReadOnlyDictionary?" {shape: diamond}
m7: "Manual: Dictionary: check whether Count or Keys is meant\n(proof: dictionary)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
s: "Welk lid geeft het aantal?" {shape: diamond}
f1: "Fixed: x.Length.ShouldBe(n)\n(proof: array)" {style.fill: "#c8e6c9"; style.font-color: "#000000"; style.border-radius: 12}
f2: "Fixed: x.Count.ShouldBe(n[, because]); haakjes om niet-veilige receiver\n(proof: list, list-because, collection-interfaces, receiver-parens)" {style.fill: "#c8e6c9"; style.font-color: "#000000"; style.border-radius: 12}
f3: "Fixed: x.Count().ShouldBe(n) + using System.Linq\n(proof: enumerable, enumerable-because, enumerable-existing-using)" {style.fill: "#c8e6c9"; style.font-color: "#000000"; style.border-radius: 12}
mx1: "Manual: Non-generic IEnumerable: use Cast<T>().Count()\n(geen proof)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
start -> q1
q1 -> m1: nee
q1 -> q2: ja
q2 -> m2: nee
q2 -> q3: ja
q3 -> m3: nee
q3 -> q4: ja
q4 -> m4: nee
q4 -> q5: ja
q5 -> m5: nee
q5 -> q6: ja
q6 -> m6: nee
q6 -> q7: ja
q7 -> m7: nee
q7 -> s: ja
s -> f1: "array, of alleen publieke int Length"
s -> f2: "publieke int Count"
s -> f3: "alleen IEnumerable<T>"
s -> mx1: "niet-generieke IEnumerable"
