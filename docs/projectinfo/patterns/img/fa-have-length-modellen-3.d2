title: "[Activity] FluentAssertionPattern.Rewrite + HaveLengthPattern.RewriteAssertion - Fixed of Manual" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: down
vars: {
  d2-legend: {
    f: Fixed {style.fill: "#c8e6c9"; style.font-color: "#000000"}
    m: Manual {style.fill: "#ffe0b2"; style.font-color: "#000000"}
  }
}
start: "" {shape: circle; width: 20; style: {fill: black; stroke: "#9ca3af"}}
q0: "Buiten een AssertionScope?" {shape: diamond}
m0: "Manual: Inside an AssertionScope\n(proof: assertion-scope)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
start -> q0
q0 -> m0: nee
q1: "Vorm s.Should().HaveLength(..)?" {shape: diamond}
m1: "Manual: is not in the form s.Should()\n(geen proof; .And via fa.and-chain)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q0 -> q1: ja
q1 -> m1: nee
q2: "Resultaat weggegooid?" {shape: diamond}
m2: "Manual: is used\n(geen proof)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q1 -> q2: ja
q2 -> m2: nee
q3: "Geen benoemde argumenten; because constant formatteerbaar?" {shape: diamond}
m3: "Manual: named arguments, or becauseArgs whose because is no constant format string\n(geen proof)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q2 -> q3: ja
q3 -> m3: nee
q4: "Geen ?. in het subject?" {shape: diamond}
m4: "Manual: uses ?.\n(geen proof)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q3 -> q4: ja
q4 -> m4: nee
q5: "Op StringAssertions?" {shape: diamond}
m5: "Manual: on a stream\n(proof: stream)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q4 -> q5: ja
q5 -> m5: nee
f0: "Fixed: s[.ShouldNotBeNull()].Length.ShouldBe(n[, because])\n(simple, because, because-args, nullable, receiver-parens)" {style.fill: "#c8e6c9"; style.font-color: "#000000"; style.border-radius: 12}
q5 -> f0: ja
