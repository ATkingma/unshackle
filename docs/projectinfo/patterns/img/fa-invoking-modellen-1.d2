title: "[Class] InvokingPattern" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: down
ipattern: "«interface» IPattern" {
  shape: class
  "+Find(root, model)": "IEnumerable<SyntaxNode>"
  "+Rewrite(node, model)": PatternResult
}
pattern: InvokingPattern {
  shape: class
  "+Id": "fa.invoking"
  "+Find(root, model)": "IEnumerable<SyntaxNode>"
  "+Rewrite(node, model)": PatternResult
}
inv: "ThrowSyntax (static)" {
  shape: class
  "+FindThrow / FindThrowAsync / FindNotThrow(root, model, owns)": "IEnumerable<SyntaxNode>"
  "+IsInvoking(assertion, model)": bool
  "+Rewrite(node, model)": PatternResult
  "+TryGetAction(...)": bool
}
throw: "ThrowPattern / ThrowAsyncPattern / NotThrowPattern" {
  shape: class
  "+Rewrite(node, model)": PatternResult
}
msg: ThrowMessage {
  shape: class
  "+OfType(thrown, throwName)": ExpressionSyntax
  "+Check(thrown, pattern, because)": PatternResult
  "+MayThrowAggregate(action, type, model)": bool
}
result: "PatternResult (Fixed / Manual)" {shape: class}
fa: "«FluentAssertions» herkend" {
  shape: class
  "x.Invoking(s => ...)": ""
  "x.Awaiting(s => ...)": ""
  "Throw / ThrowAsync / ThrowExactly(Async) / NotThrow": ""
}
sh: "«Shouldly» aangemaakt" {
  shape: class
  "Should.Throw<T>(() => x.M())": ""
  "await Should.ThrowAsync<T>(() => x.M())": ""
  "Should.NotThrow(() => x.M())": ""
}
pattern -> ipattern: realiseert {target-arrowhead: {shape: triangle; style.filled: false}; style.stroke-dash: 3}
pattern -> inv: "Find + Rewrite" {style.stroke-dash: 3}
inv -> throw: delegeert {style.stroke-dash: 3}
throw -> msg: gebruikt {style.stroke-dash: 3}
throw -> result: levert {style.stroke-dash: 3}
pattern -> fa: herkent {style.stroke-dash: 3}
throw -> sh: bouwt {style.stroke-dash: 3}
