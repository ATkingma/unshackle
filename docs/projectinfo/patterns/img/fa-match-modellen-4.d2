title: "[Activity] FluentAssertionPattern.Rewrite + MatchPattern.RewriteAssertion - Fixed of Manual (2/2)" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: down
vars: {
  d2-legend: {
    f: Fixed {style.fill: "#c8e6c9"; style.font-color: "#000000"}
    m: Manual {style.fill: "#ffe0b2"; style.font-color: "#000000"}
  }
}
q3: "Geen benoemde argumenten; because constant formatteerbaar?" {shape: diamond}
m3: "Manual: named arguments, or becauseArgs whose because is no constant format string\n(geen proof)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q4: "Subject is een string?" {shape: diamond}
m4: "Manual: on a non-string subject\n(proof: predicate)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
q5: "Eén niet-lege stringconstante?" {shape: diamond}
m5: "Manual: without one non-empty string constant\n(proof: regex-object, variable, empty)" {style.fill: "#ffe0b2"; style.font-color: "#000000"; style.border-radius: 12}
f0: "Fixed: s.ShouldMatch(r) / ShouldNotMatch(r), patroon ongewijzigd\n(proof: regex, not-regex, because, nullable)" {style.fill: "#c8e6c9"; style.font-color: "#000000"; style.border-radius: 12}
f1: "Fixed: s.ShouldMatch(@\"(?s)\\A...\$\") / ShouldNotMatch\n(proof: wildcard, not-wildcard)" {style.fill: "#c8e6c9"; style.font-color: "#000000"; style.border-radius: 12}
from_previous_q3: "From Figure 3a" {shape: oval; style: {fill: "#e5e7eb"; font-color: "#000000"}}
from_previous_q3 -> q3
q3 -> m3: nee
q3 -> q4: ja
q4 -> m4: nee
q4 -> q5: ja
q5 -> m5: nee
