title: "[Class] NotBePattern" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: down
vars: {
  d2-legend: {
    a: "" {style.opacity: 0}
    b: "" {style.opacity: 0}
    a -> b: "Realisatie (holle driehoek), overerving (holle driehoek), dependency (gestreept)"
  }
}
ipattern: "«interface» IPattern" {
  shape: class
  "+Id": string
  "+Description": string
  "+Find(root, model)": "IEnumerable<SyntaxNode>"
  "+Rewrite(node, model)": PatternResult
}
base: "FluentAssertionPattern (abstract)" {
  shape: class
  "+Rewrite(node, model)": PatternResult
  "#RewriteBeforeArguments(context)": "PatternResult?"
  "#RewriteAssertion(context)": "PatternResult (abstract)"
}
NotBePattern: NotBePattern {
  shape: class
  "+Id": "fa.not-be"
  "+Find(root, model)": "IEnumerable<SyntaxNode>"
  "#ShouldName": "\"ShouldNotBe\""
}
ShouldBePattern: ShouldBePattern {
  shape: class
  "#ShouldName": "\"ShouldBe\" (virtual)"
  "#RewriteAssertion(context)": PatternResult
}
syntax: FluentAssertionsSyntax {
  shape: class
  "+FindInvocations(root, model, names)": "IEnumerable<InvocationExpressionSyntax>"
  "+IsInsideAssertionScope(node, model)": bool
  "+GetSubject(assertion)": "ExpressionSyntax?"
  "+IsResultDiscarded(assertion, model)": bool
  "+TryGetArguments(assertion, model, values, because)": bool
  "+ConvertExpected(expected, subjectType, model, position)": "ExpressionSyntax?"
}
result: "PatternResult (abstract)" {
  shape: class
  "+Fixed(newNode, namespaces)": PatternResult
  "+Manual(reason)": PatternResult
}
fixed: FixedResult {
  shape: class
  "+NewNodes": "IReadOnlyList<SyntaxNode>"
  "+RequiredNamespaces": "IReadOnlyList<string>"
}
manual: ManualResult {
  shape: class
  "+Reason": string
}
fa: "«FluentAssertions» herkend" {
  shape: class
  "NotBe(unexpected[, because])": ""
  "NotBe uit FluentAssertions.Xml / .Types": ""
}
sh: "«Shouldly» aangemaakt" {
  shape: class
  "ShouldNotBe(unexpected[, because])": ""
  "cast naar het subjecttype": ""
}
base -> ipattern: realiseert {target-arrowhead: {shape: triangle; style.filled: false}; style.stroke-dash: 3}
ShouldBePattern -> base: erft {target-arrowhead: {shape: triangle; style.filled: false}}
NotBePattern -> ShouldBePattern: erft {target-arrowhead: {shape: triangle; style.filled: false}}
ShouldBePattern -> syntax: "gebruikt (ConvertExpected)" {style.stroke-dash: 3}
NotBePattern -> result: levert {style.stroke-dash: 3}
fixed -> result: erft {target-arrowhead: {shape: triangle; style.filled: false}}
manual -> result: erft {target-arrowhead: {shape: triangle; style.filled: false}}
NotBePattern -> fa: herkent {style.stroke-dash: 3}
NotBePattern -> sh: bouwt {style.stroke-dash: 3}
