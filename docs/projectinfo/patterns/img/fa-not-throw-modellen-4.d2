f1: "Fixed: Should.NotThrow(act)\n(proof: simple, func, value-func)" {style.fill: "#c8e6c9"; style.font-color: "#000000"; style.border-radius: 12}
f2: "Fixed: Should.NotThrow(act, because)\nbecauseArgs: string.Format(InvariantCulture, because, args)\n(proof: because, because-args)" {style.fill: "#c8e6c9"; style.font-color: "#000000"; style.border-radius: 12}
