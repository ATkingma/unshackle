title: "[Class] OnlyContainPattern" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: right
ipattern: "«interface» IPattern" {
  shape: class
  "+Id": string
  "+Find(root, model)": "IEnumerable<SyntaxNode>"
  "+Rewrite(node, model)": PatternResult
}
base: "FluentAssertionPattern (abstract)" {
  shape: class
  "+Rewrite(node, model)": PatternResult
  "#GetAssertion(node)": InvocationExpressionSyntax
  "#RewriteAssertion(context)": PatternResult
}
pattern: OnlyContainPattern {
  shape: class
  "+Find(root, model)": "IEnumerable<SyntaxNode>"
  "#GetAssertion(node)": InvocationExpressionSyntax
  "#RewriteAssertion(context)": PatternResult
}
syntax: FluentAssertionsSyntax {
  shape: class
  "+FindInvocations(root, model, names)": ""
  "+GetSubject(assertion)": ExpressionSyntax
  "+IsResultDiscarded(assertion, model)": bool
  "+TryGetArguments(...)": bool
  "+TryGetSplittableStatement(node, out)": bool
  "+IsSafeToEvaluateTwice(e, model)": bool
  "+Hoist(e, model)": "(StatementSyntax, ExpressionSyntax)"
}
result: PatternResult {
  shape: class
  "+Fixed(nodes, namespaces)": ""
  "+Manual(reason)": ""
}
fixed: FixedResult {shape: class; "+NewNodes": ""}
manual: ManualResult {shape: class; "+Reason": string}
fa: "FluentAssertions\nOnlyContain(predicate)\n(faalt op lege collectie)"
sh: "Shouldly\nShouldNotBeEmpty\nShouldAllBe(predicate)"
pattern -> base: {target-arrowhead.shape: triangle}
base -> ipattern: {style.stroke-dash: 3; target-arrowhead.shape: triangle}
pattern -> syntax: gebruikt {style.stroke-dash: 3}
pattern -> result: maakt {style.stroke-dash: 3}
fixed -> result: {target-arrowhead.shape: triangle}
manual -> result: {target-arrowhead.shape: triangle}
fa -> pattern: herkend door Find {style.stroke-dash: 3}
pattern -> sh: bouwt twee statements {style.stroke-dash: 3}
