title: "[Sequence] ThrowAsyncPattern" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
shape: sequence_diagram
fixer: Fixer
pattern: ThrowAsyncPattern
syntax: FluentAssertionsSyntax
msg: ThrowMessage
fixer -> pattern: "Find(root, model)"
pattern -> syntax: "ThrowSyntax.FindThrowAsync → FindInvocations(root, model, ThrowAsync, ThrowExactlyAsync), zonder Exactly/Awaiting"
syntax -> pattern: "aanroepen" {style.stroke-dash: 3}
pattern -> fixer: "await-expressies" {style.stroke-dash: 3}
loop: "loop [elke node]" {
  fixer -> pattern: "Rewrite(node, model)"
  pattern -> syntax: "IsInsideAssertionScope(node, model)"
  pattern -> syntax: "GetSubject(throwCall)"
  pattern -> pattern: "IsInvoking? TryGetAction; subjecttype"
  pattern -> msg: "MayThrowAggregate (niet bij ThrowExactlyAsync)"
  pattern -> syntax: "TryGetArguments(throwCall, model)"
  pattern -> msg: "Check(thrown, pattern, because)"
  msg -> pattern: "Fixed(Message.ShouldX(...)) of Manual" {style.stroke-dash: 3}
  alt: "alt" {
    pattern -> fixer: "Fixed(await Should.ThrowAsync<T>(act))" {style.stroke-dash: 3}
  }
  alt2: "else" {
    pattern -> fixer: "Manual(reden)" {style.stroke-dash: 3}
  }
}
