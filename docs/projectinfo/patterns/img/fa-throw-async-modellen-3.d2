title: "[Beslisboom] ThrowAsyncPattern.Rewrite" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: down
q1: "ThrowExactlyAsync?" {shape: diamond}
q3: "Direct geawaite statement?" {shape: diamond}
q4: "Subject Func<Task> of\nFunc<Task<ref type>>?" {shape: diamond}
q5: "becauseArgs?" {shape: diamond}
q6: "WithMessage?" {shape: diamond}
