title: "[Beslisboom] PipelineBehaviorPattern.Rewrite (2/2)" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: down
q5: "Elke return next(...)\nof Task.FromResult?" {shape: diamond}
q6: "Request-type is typeparameter\nvan de klasse?" {shape: diamond}
