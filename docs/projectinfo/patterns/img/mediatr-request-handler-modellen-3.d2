title: "[Beslisboom] RequestHandlerPattern.Rewrite" {shape: text; near: top-center; style: {font-size: 24; bold: true}}
direction: down
q1: "Expliciete interface-\nimplementatie?" {shape: diamond}
q2: "Returntype Task<T>\n(ook gekwalificeerd)?" {shape: diamond}
q3: "async?" {shape: diamond}
q4: "Elke return / expression body\nTask.FromResult(...)?" {shape: diamond}
m1: "Manual: explicit interface implementation\n(explicit)"
m2: "Manual: does not return Task<T>"
f1: "ValueTask<T>, body blijft\n(async, token-name)"
f2: "ValueTask<T> + ValueTask.FromResult(...)\n(from-result-*, generic)"
m3: "Manual: not Task.FromResult\n(other-return)"
q1 -> m1: ja
q1 -> q2: nee
q2 -> m2: nee
q2 -> q3: ja
q3 -> f1: ja
q3 -> q4: nee
q4 -> f2: ja
q4 -> m3: nee
