  <ItemGroup>
    <InternalsVisibleTo Include="Unshackle.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Broncode die een fix in de oplossing van de gebruiker zet (TAAK-194): data, geen code van Core zelf -->
