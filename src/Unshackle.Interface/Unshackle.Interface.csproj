<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>unshackle</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>unshackle</ToolCommandName>
    <PackageId>Unshackle</PackageId>
    <Version>0.3.0</Version>
    <Authors>Timme Kingma</Authors>
    <Description>Migrates .NET code away from libraries that went commercial: FluentAssertions → Shouldly, MediatR → Mediator, AutoMapper → hand-written mappings, Moq → NSubstitute, Polly v7 → Microsoft.Extensions.Resilience, EPPlus → ClosedXML; MassTransit v8 inventory. Roslyn-based, with a report and --dry-run; what it cannot rewrite safely is reported as manual work.</Description>
    <PackageTags>fluentassertions;shouldly;mediatr;mediator;automapper;migration;roslyn;dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/ATkingma/unshackle</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ATkingma/unshackle</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Unshackle.Core\Unshackle.Core.csproj" />
    <ProjectReference Include="..\Unshackle.DataAccess\Unshackle.DataAccess.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Spectre.Console" />
    <!-- Only as metadata for the semantic model while fixing (TAAK-116), never loaded: the netstandard2.0 build binds in
         projects of every target framework (the net9.0 one gives CS1705 in a net8.0 project). -->
    <PackageReference Include="Shouldly" GeneratePathProperty="true" ExcludeAssets="all" />
    <None Include="$(PkgShouldly)/lib/netstandard2.0/Shouldly.dll" Link="References/Shouldly.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <!-- Same for NSubstitute (TAAK-307): the Moq fix binds rewritten Returns/Received calls before the create step. -->
    <PackageReference Include="NSubstitute" GeneratePathProperty="true" ExcludeAssets="all" />
    <None Include="$(PkgNSubstitute)/lib/netstandard2.0/NSubstitute.dll" Link="References/NSubstitute.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
