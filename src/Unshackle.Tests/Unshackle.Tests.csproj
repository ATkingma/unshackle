<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Unshackle.Core\Unshackle.Core.csproj" />
    <ProjectReference Include="..\Unshackle.DataAccess\Unshackle.DataAccess.csproj" />
    <ProjectReference Include="..\Unshackle.Interface\Unshackle.Interface.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.TestingHelpers" />
    <PackageReference Include="Basic.Reference.Assemblies.Net100" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>
  <ItemGroup Label="Proof references: de echte types voor het SemanticModel">
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="MediatR" />
    <!-- 14.0.0 is bewust de laatste vrije versie; alleen nodig als types voor proofs -->
    <PackageReference Include="AutoMapper" NoWarn="NU1903" />
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="EPPlus" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="MassTransit" />
    <!-- Bouwt op MediatR; de fix zet de broncode ervan in de oplossing (TAAK-194) -->
    <PackageReference Include="Ardalis.SharedKernel" />
    <PackageReference Include="Autofac" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" />
    <!-- TAAK-340: only the runtime API as types; no build assets (no feature-file generation in this project) -->
    <PackageReference Include="SpecFlow" IncludeAssets="compile;runtime" />
    <PackageReference Include="Reqnroll" IncludeAssets="compile;runtime" />
    <!-- Niet als analyzer van dit project: de proofs draaien de generator zelf op hun "after" (TestReferences.MediatorGenerators) -->
    <PackageReference Include="Mediator.SourceGenerator" IncludeAssets="none" PrivateAssets="all" GeneratePathProperty="true" />
    <None Include="$(PkgMediator_SourceGenerator)/analyzers/dotnet/cs/*.dll" Link="Generators/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- TAAK-341: xUnit v2 for the xunit3 proofs' "before"; not compiled here (its Xunit types would clash with xunit.v3), copied to XunitV2/ -->
    <PackageReference Include="xunit.extensibility.core" IncludeAssets="none" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="xunit.extensibility.execution" IncludeAssets="none" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="xunit.assert" IncludeAssets="none" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="xunit.abstractions" IncludeAssets="none" PrivateAssets="all" GeneratePathProperty="true" />
    <None Include="$(Pkgxunit_extensibility_core)/lib/netstandard1.1/xunit.core.dll" Link="XunitV2/xunit.core.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(Pkgxunit_extensibility_execution)/lib/netstandard1.1/xunit.execution.dotnet.dll" Link="XunitV2/xunit.execution.dotnet.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(Pkgxunit_assert)/lib/netstandard1.1/xunit.assert.dll" Link="XunitV2/xunit.assert.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(Pkgxunit_abstractions)/lib/netstandard2.0/xunit.abstractions.dll" Link="XunitV2/xunit.abstractions.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- TAAK-341 X2: the proofs' "after" compiles against the default target xunit.v3 3.2.2 (XunitV3Fix.V3Version), not this project's own
         xunit.v3; downloaded only (no reference, no version conflict) and copied to XunitV3/ -->
    <PackageDownload Include="xunit.v3.extensibility.core" Version="[3.2.2]" />
    <PackageDownload Include="xunit.v3.common" Version="[3.2.2]" />
    <PackageDownload Include="xunit.v3.assert" Version="[3.2.2]" />
    <None Include="$(NuGetPackageRoot)xunit.v3.extensibility.core/3.2.2/lib/netstandard2.0/xunit.v3.core.dll" Link="XunitV3/xunit.v3.core.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NuGetPackageRoot)xunit.v3.common/3.2.2/lib/netstandard2.0/xunit.v3.common.dll" Link="XunitV3/xunit.v3.common.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NuGetPackageRoot)xunit.v3.assert/3.2.2/lib/net8.0/xunit.v3.assert.dll" Link="XunitV3/xunit.v3.assert.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Proofs zijn testdata, geen code van het testproject zelf -->
    <Compile Remove="Proofs\**" />
    <None Include="Proofs\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
