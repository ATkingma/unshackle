<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Unshackle.Core\Unshackle.Core.csproj" />
    <ProjectReference Include="..\Unshackle.DataAccess\Unshackle.DataAccess.csproj" />
    <ProjectReference Include="..\Unshackle.Interface\Unshackle.Interface.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.TestingHelpers" />
    <PackageReference Include="Basic.Reference.Assemblies.Net100" />
  </ItemGroup>
  <ItemGroup Label="Proof references: de echte types voor het SemanticModel">
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="MediatR" />
    <!-- 14.0.0 is bewust de laatste vrije versie; alleen nodig als types voor proofs -->
    <PackageReference Include="AutoMapper" NoWarn="NU1903" />
    <PackageReference Include="Mediator.Abstractions" />
    <!-- Bouwt op MediatR; de fix zet de broncode ervan in de oplossing (TAAK-194) -->
    <PackageReference Include="Ardalis.SharedKernel" />
    <PackageReference Include="Autofac" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" />
    <!-- Niet als analyzer van dit project: de proofs draaien de generator zelf op hun "after" (TestReferences.MediatorGenerators) -->
    <PackageReference Include="Mediator.SourceGenerator" IncludeAssets="none" PrivateAssets="all" GeneratePathProperty="true" />
    <None Include="$(PkgMediator_SourceGenerator)/analyzers/dotnet/cs/*.dll" Link="Generators/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Proofs zijn testdata, geen code van het testproject zelf -->
    <Compile Remove="Proofs\**" />
    <None Include="Proofs\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
